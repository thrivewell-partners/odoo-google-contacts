<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.twp.google.contacts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="integration" position="inside">
                <setting id="twp_google_contacts" string="Google Contacts"
                         help="Each user syncs their own Google Contacts with Odoo, through ThriveWell Connect">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="twp_google_contacts_broker_key" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_broker_key" password="True"/>
                        </div>
                        <div class="row" groups="base.group_no_one">
                            <label for="twp_google_contacts_broker_url" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_broker_url"/>
                        </div>
                        <div class="row mt8">
                            <label for="twp_google_contacts_direction" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_direction"/>
                        </div>
                        <div class="row">
                            <label for="twp_google_contacts_owners" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_owners"/>
                        </div>
                        <div class="row">
                            <label for="twp_google_contacts_import" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_import"/>
                        </div>
                        <div class="row">
                            <label for="twp_google_contacts_scope" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_scope"/>
                        </div>
                        <div class="row" invisible="twp_google_contacts_scope != 'tagged'">
                            <label for="twp_google_contacts_tag_ids" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_tag_ids" widget="many2many_tags"/>
                        </div>
                        <div class="row">
                            <label for="twp_google_contacts_label" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_label"/>
                        </div>
                        <div class="mt8">
                            <span class="o_form_label">Details that sync</span>
                            <div class="text-muted">The name always syncs.</div>
                            <div class="d-flex flex-wrap gap-3">
                                <span><field name="twp_google_contacts_sync_organization"/><label for="twp_google_contacts_sync_organization" class="o_light_label"/></span>
                                <span><field name="twp_google_contacts_sync_email"/><label for="twp_google_contacts_sync_email" class="o_light_label"/></span>
                                <span><field name="twp_google_contacts_sync_phone"/><label for="twp_google_contacts_sync_phone" class="o_light_label"/></span>
                                <span><field name="twp_google_contacts_sync_address"/><label for="twp_google_contacts_sync_address" class="o_light_label"/></span>
                                <span><field name="twp_google_contacts_sync_website"/><label for="twp_google_contacts_sync_website" class="o_light_label"/></span>
                                <span><field name="twp_google_contacts_sync_note"/><label for="twp_google_contacts_sync_note" class="o_light_label"/></span>
                                <span><field name="twp_google_contacts_sync_photo"/><label for="twp_google_contacts_sync_photo" class="o_light_label"/></span>
                            </div>
                        </div>
                        <div class="row mt8">
                            <label for="twp_google_contacts_conflict" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_conflict"/>
                        </div>
                        <div class="row">
                            <label for="twp_google_contacts_archive_deleted" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_archive_deleted"/>
                        </div>
                        <div class="row" groups="base.group_no_one">
                            <label for="twp_google_contacts_test_database" class="col-lg-4 o_light_label"/>
                            <field name="twp_google_contacts_test_database"/>
                        </div>
                        <button name="%(twp_google_contacts_account_action)d" type="action"
                                string="Connected accounts" icon="oi-arrow-right"
                                class="btn-link mt8"/>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
