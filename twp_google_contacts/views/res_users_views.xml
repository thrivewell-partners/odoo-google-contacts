<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_preferences" model="ir.ui.view">
        <field name="name">res.users.preferences.form.twp.google.contacts</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <page name="calendar" position="after">
                <page string="Google Contacts" name="twp_google_contacts" invisible="share">
                    <group>
                        <group>
                            <field name="google_contacts_state" readonly="1"/>
                            <field name="google_contacts_email" readonly="1"
                                   invisible="google_contacts_state == 'none'"/>
                        </group>
                        <group invisible="google_contacts_state == 'none'">
                            <field name="google_contacts_direction" required="google_contacts_state != 'none'"/>
                            <field name="google_contacts_owners" required="google_contacts_state != 'none'"
                                   invisible="google_contacts_direction == 'to_odoo'"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status"
                         invisible="not google_contacts_review_count">
                        <field name="google_contacts_review_count" class="fw-bold" readonly="1"/>
                        contacts from Google are waiting for you to say which Odoo contact each one is.
                        <button name="action_google_contacts_review" type="object"
                                string="Review" class="btn-link"/>
                    </div>
                    <div>
                        <button name="action_google_contacts_connect" type="object"
                                string="Connect" class="btn-primary"
                                invisible="google_contacts_state == 'connected'"/>
                        <button name="action_google_contacts_sync" type="object"
                                string="Sync now" class="btn-primary"
                                invisible="google_contacts_state != 'connected'"/>
                        <button name="action_google_contacts_check" type="object"
                                string="Check connection" class="btn-secondary ms-2"
                                invisible="google_contacts_state != 'connected'"/>
                        <button name="action_google_contacts_disconnect" type="object"
                                string="Disconnect" class="btn-secondary ms-2"
                                invisible="google_contacts_state == 'none'"
                                confirm="Disconnect Google Contacts? Odoo gives the sign-in back and stops syncing."/>
                    </div>
                </page>
            </page>
        </field>
    </record>
</odoo>
